{
  "manifest_version": 3,
  "name": "ASCII Flow",
  "version": "3.1.6",
  "description": "Responsive ASCII cursor effects with audio-reactive visuals.",
  "permissions": [
    "offscreen",
    "tabCapture",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "ASCII Flow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-ascii-flow": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Toggle ASCII Flow on or off"
    }
  }
}
